{
  "name": "f1-telemetry-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing F1 game telemetry (sessions, laps, sectors, braking, tyres) to AI assistants",
  "type": "module",
  "license": "MIT",
  "author": "Kaspars Bergs",
  "bin": { "f1-telemetry-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "generate:sample": "tsx scripts/generate-sample.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
