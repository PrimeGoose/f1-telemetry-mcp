{
  "name": "f1-telemetry-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing F1 game telemetry (sessions, laps, sectors, braking, tyres) to AI assistants",
  "type": "module",
  "license": "MIT",
  "author": "Kaspars Bergs",
  "bin": {
    "f1-telemetry-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "generate:sample": "tsx scripts/generate-sample.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx evals/run-deterministic.ts",
    "eval:agent": "tsx evals/run-agent.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "f1-23-udp": "^1.1.0",
    "zod": "^4.6.5"
  }
}
